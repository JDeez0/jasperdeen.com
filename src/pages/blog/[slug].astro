---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, isScheduled } from "../../lib/content";

// Pre-render a static page per published blog post. Drafts/future posts are
// excluded from the build (their URLs simply don't exist).
export async function getStaticPaths() {
  const posts = await getCollection("blog", isScheduled);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — Jasper Deen`}
  description={post.data.description}
>
  <main class="page">
    <article>
      <header class="post-header">
        <a class="post-back" href="/blog/">← Blog</a>
        <h1 class="display display--small">{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.tags.length > 0 && (
            <span class="post-tags">
              {" · "}
              {post.data.tags.join(", ")}
            </span>
          )}
        </p>
      </header>
      <div class="post-body prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .post-back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .post-back:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 2.5rem;
  }
</style>