---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts } from "../../lib/content";

const posts = getPublishedPosts(await getCollection("blog"));
---

<Base
  title="Blog — Jasper Deen"
  description="Writing from Jasper Deen."
>
  <main class="page">
    <header class="content-head">
      <h1 class="display display--small">Blog</h1>
    </header>

    <section class="post-list" aria-label="Blog posts">
      {posts.length === 0 && <p class="coming-soon">Nothing here yet — coming soon.</p>}
      {posts.map((post) => (
        <a class="post-item" href={`/blog/${post.id}/`}>
          <h2>{post.data.title}</h2>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.description && <p>{post.data.description}</p>}
        </a>
      ))}
    </section>
  </main>
</Base>

<style>
  .post-list {
    /* Two tiles per row, each filling half the width — card 1 left, card 2
       right, card 3 left, and so on (grid flows left-to-right). */
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .coming-soon {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
  }
  .post-item {
    /* Wider than square (7:6), content top-aligned. */
    aspect-ratio: 7 / 6;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 1.125rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .post-item:hover {
    border-color: var(--outline);
    transform: translateY(-2px);
  }
  .post-item h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
  }
  .post-item time {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .post-item p {
    margin: 0.6rem 0 0;
    color: var(--ink);
  }
</style>