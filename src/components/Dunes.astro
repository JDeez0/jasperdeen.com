---
// Wind-blown crescent (sickle) dune field for the top of the home page.
//
// Physics: each dune has a CREST — a gentle windward rise up to a peak and a
// SHORT STEEP SLIP FACE down the lee side. The slip face is shaded DENSE
// (dark) with short near-vertical strokes + cross strokes; the windward side
// is shaded SPARSE (light) with long horizontal ripple contours that trail off
// toward the next dune. Orientation (which side is the slip face) follows a
// smooth function of position, so it varies in coherent groups.
//
// Layered depth: 1-3 layers, back (smaller, higher, lighter) to front (larger,
// lower, darker). Layers are staggered so back dunes peek between the gaps of
// front dunes.
//
// Architecture: buildDune() is the reusable unit; the field is assembled by
// instantiating it across the width from a deterministic seeded RNG — style
// stays perfectly consistent at any width. Static SVG, zero runtime JS,
// non-scaling stroke (crisp), currentColor (dark-mode aware).
const W = 1600;
const H = 150;

// --- deterministic seeded RNG ---
function mulberry32(seed: number) {
  let a = seed;
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260831);

type Dune = {
  cx: number;
  footY: number;
  h: number;
  ww: number;
  ws: number;
  o: 1 | -1;
  slipN: number;
  ripN: number;
  layer: number;
};

function cubicPoint(
  x0: number, y0: number,
  x1: number, y1: number,
  x2: number, y2: number,
  x3: number, y3: number,
  t: number,
): { x: number; y: number } {
  const u = 1 - t;
  return {
    x: u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3,
    y: u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3,
  };
}

function buildDune(d: Dune) {
  const peakX = d.cx;
  const peakY = d.footY - d.h;
  const windX = d.cx - d.o * d.ww;
  const windY = d.footY;
  const slipX = d.cx + d.o * d.ws;
  const slipY = d.footY + d.h * 0.12;

  const wc1x = windX + 0.62 * (peakX - windX);
  const wc1y = windY;
  const wc2x = peakX - 0.1 * (peakX - windX);
  const wc2y = peakY;
  const sc1x = peakX + 0.12 * (slipX - peakX);
  const sc1y = peakY;
  const sc2x = slipX - 0.18 * (slipX - peakX);
  const sc2y = slipY;

  const crest = `M ${windX.toFixed(1)} ${windY.toFixed(1)} C ${wc1x.toFixed(1)} ${wc1y.toFixed(1)}, ${wc2x.toFixed(1)} ${wc2y.toFixed(1)}, ${peakX.toFixed(1)} ${peakY.toFixed(1)} C ${sc1x.toFixed(1)} ${sc1y.toFixed(1)}, ${sc2x.toFixed(1)} ${sc2y.toFixed(1)}, ${slipX.toFixed(1)} ${slipY.toFixed(1)}`;

  // Slip face: dense short near-vertical strokes down the lee side.
  let slip = "";
  for (let k = 0; k < d.slipN; k++) {
    const t = 0.03 + (0.94 * k) / Math.max(1, d.slipN - 1);
    const p = cubicPoint(peakX, peakY, sc1x, sc1y, sc2x, sc2y, slipX, slipY, t);
    const len = d.h * 0.65 + rnd() * 3;
    slip += `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} L ${(p.x + d.o * len * 0.32).toFixed(1)} ${(p.y + len).toFixed(1)} `;
  }
  // Cross strokes in the slip face (front layers only) -> deeper shadow.
  let cross = "";
  if (d.layer >= 1) {
    const n2 = Math.round(d.slipN * 0.7);
    for (let k = 0; k < n2; k++) {
      const t = 0.05 + (0.9 * k) / Math.max(1, n2 - 1);
      const p = cubicPoint(peakX, peakY, sc1x, sc1y, sc2x, sc2y, slipX, slipY, t);
      const len = d.h * 0.4;
      cross += `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} L ${(p.x - d.o * len * 0.5).toFixed(1)} ${(p.y + len).toFixed(1)} `;
    }
  }

  // Windward ripples: long horizontal contours trailing off the crest.
  let ripples = "";
  const fracs = [0.12, 0.24, 0.36, 0.48, 0.6, 0.72, 0.83, 0.92].slice(0, d.ripN);
  for (const f of fracs) {
    const s = cubicPoint(windX, windY, wc1x, wc1y, wc2x, wc2y, peakX, peakY, f);
    const rl = d.ww + 80 + rnd() * 70;
    const ex = s.x - d.o * rl;
    const ey = d.footY + (rnd() * 2 - 1) * 5;
    const c1x = s.x - d.o * 0.2 * rl;
    const c1y = s.y;
    const c2x = ex + d.o * 0.16 * rl;
    const c2y = ey;
    ripples += `M ${s.x.toFixed(1)} ${s.y.toFixed(1)} C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${ex.toFixed(1)} ${ey.toFixed(1)} `;
  }

  return { crest, slip, cross, ripples };
}

// --- assemble the field ---
const layerPlan = [
  { n: 6, footY: 46, h: [22, 30], ww: [120, 160], ws: [12, 18], slipN: [16, 20], ripN: 7, phase: 0, phaseOff: 0 },
  { n: 5, footY: 82, h: [30, 42], ww: [150, 200], ws: [16, 22], slipN: [20, 24], ripN: 8, phase: 0.5, phaseOff: 1.2 },
  { n: 4, footY: 122, h: [40, 54], ww: [190, 250], ws: [20, 28], slipN: [26, 32], ripN: 9, phase: 0.25, phaseOff: 2.4 },
];

const range = (a: number, b: number) => a + rnd() * (b - a);
const pick = (a: number, b: number) => Math.round(range(a, b));

const dunes: Dune[] = [];
for (let li = 0; li < layerPlan.length; li++) {
  const L = layerPlan[li];
  const spacing = W / L.n;
  for (let i = 0; i < L.n; i++) {
    const baseX = (i + L.phase) * spacing;
    const cx = Math.max(20, Math.min(W - 20, baseX + (rnd() * 2 - 1) * spacing * 0.12));
    const o: 1 | -1 = Math.sin((cx / W) * Math.PI * 2 * 1.5 + L.phaseOff + 0.6) >= 0 ? 1 : -1;
    const ridge = rnd() < 0.25;
    const ww = range(L.ww[0], L.ww[1]) * (ridge ? 1.5 : 1);
    const h = range(L.h[0], L.h[1]) * (ridge ? 0.7 : 1);
    const ws = range(L.ws[0], L.ws[1]) * (ridge ? 0.8 : 1);
    dunes.push({
      cx,
      footY: L.footY,
      h,
      ww,
      ws,
      o,
      slipN: pick(L.slipN[0], L.slipN[1]),
      ripN: L.ripN,
      layer: li,
    });
  }
}
dunes.sort((a, b) => a.layer - b.layer || a.cx - b.cx);

const built = dunes.map((d) => ({ ...buildDune(d), layer: d.layer }));

// Ground ripples below the front dune line (wind-blown sand surface).
let ground = "";
for (let g = 0; g < 3; g++) {
  const gy = layerPlan[2].footY + 4 + g * 8;
  let d = `M 0 ${gy.toFixed(1)} `;
  for (let s = 1; s <= 32; s++) {
    const x = (s / 32) * W;
    const y = gy + Math.sin((x / W) * Math.PI * 2 * 2.6 + g * 1.1) * 3;
    d += `L ${x.toFixed(1)} ${y.toFixed(1)} `;
  }
  ground += d;
}
---

<div class="dunes">
  <svg
    class="dunes-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d={ground} stroke-width="0.7" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" stroke-linecap="round" />
    {built.map((b) => (
      <g fill="none" stroke="currentColor">
        <path d={b.ripples} stroke-width="0.85" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        <path d={b.cross} stroke-width="0.7" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        <path d={b.slip} stroke-width="1" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        <path
          d={b.crest}
          stroke-width={(1.2 + 0.18 * b.layer).toFixed(2)}
          vector-effect="non-scaling-stroke"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    ))}
  </svg>
</div>