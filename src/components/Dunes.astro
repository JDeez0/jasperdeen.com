---
// Connected dune landscape for the top of the home page.
//
// Technique (matched to the reference examples): every surface is drawn with
// LONG FLOWING PARALLEL CONTOUR LINES that follow the form's curvature, and
// value is created purely by line SPACING — lit windward faces stay nearly
// white (wide spacing / empty paper), shadowed slip faces carry a tapered
// dark ribbon of lines that tighten until they merge (front layers read
// near-solid). The brink (crest) is the crisp boundary where white meets
// shadow — drawn as a slightly heavier fine line, not a decorative stroke.
//
// Anatomy per mass: long gentle convex windward ramp (left, lit) rising to
// the crest, then a steep slip face (right, shadowed) descending the full
// height to the toe. Wind/light direction is the same everywhere.
//
// Depth: 3 staggered layers of overlapping masses — back = fine skyline
// (small, light), mid, front = largest, boldest, darkest ribbons, carrying
// the most masses. Front masses may overlap/occlude. Static SVG, zero
// runtime JS, non-scaling stroke, currentColor (dark-mode aware).
const W = 1600;
const H = 150;

function mulberry32(seed: number) {
  let a = seed;
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260831);
const range = (a: number, b: number) => a + rnd() * (b - a);

type Mass = {
  cx: number;
  by: number;
  h: number;
  ww: number;
  ws: number;
  layer: number;
  ribbonW: number; // max shadow ribbon width (px)
  sMin: number;    // min line spacing in ribbon (u units) — mid-face
  sMax: number;    // max spacing — ribbon ends
  windN: number;   // windward contour count
  lw: number;      // line weight
};

function cubicPoint(
  x0: number, y0: number, x1: number, y1: number,
  x2: number, y2: number, x3: number, y3: number, t: number,
): { x: number; y: number } {
  const u = 1 - t;
  return {
    x: u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3,
    y: u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3,
  };
}
const cubic = (a: number[], b: number[], c: number[], d: number[]) =>
  `M ${a[0].toFixed(1)} ${a[1].toFixed(1)} C ${b[0].toFixed(1)} ${b[1].toFixed(1)}, ${c[0].toFixed(1)} ${c[1].toFixed(1)}, ${d[0].toFixed(1)} ${d[1].toFixed(1)}`;

function buildMass(m: Mass) {
  const cx = m.cx, by = m.by, h = m.h, ww = m.ww, ws = m.ws;
  const peak = [cx, by - h];
  const windToe = [cx - ww, by];
  const slipToe = [cx + ws, by - h * 0.06];

  // Brink (crest edge): steep, slightly concave, full slip-face height.
  const b1 = [peak[0] + 0.18 * ws, peak[1] + 0.06 * h];
  const b2 = [slipToe[0] - 0.12 * ws, slipToe[1] - 0.02 * h];
  const S = 20;
  const pts: { x: number; y: number }[] = [];
  const nrm: { x: number; y: number }[] = [];
  for (let k = 0; k <= S; k++) {
    const t = k / S;
    pts.push(cubicPoint(peak[0], peak[1], b1[0], b1[1], b2[0], b2[1], slipToe[0], slipToe[1], t));
  }
  for (let k = 0; k <= S; k++) {
    const a = pts[Math.max(0, k - 1)];
    const b = pts[Math.min(S, k + 1)];
    let tx = b.x - a.x, ty = b.y - a.y;
    const l = Math.hypot(tx, ty) || 1;
    tx /= l; ty /= l;
    nrm.push({ x: ty, y: -tx }); // points into the shadowed face (right)
  }
  // Ribbon width: tapered — zero-ish at both ends, max mid-face.
  const wAt = (t: number) => m.ribbonW * Math.pow(Math.sin(Math.PI * t), 0.8) + 0.8;

  // Shadow ribbon: lines offset from the brink, spacing tightest mid-face
  // (merging there), opening toward the ribbon tips.
  let shadow = "";
  let u = 0.02;
  let guard = 0;
  while (u <= 1 && guard++ < 60) {
    let d = "";
    for (let k = 0; k <= S; k++) {
      const o = u * wAt(k / S);
      const x = Math.round(pts[k].x + nrm[k].x * o);
      const y = Math.round(pts[k].y + nrm[k].y * o);
      d += (k === 0 ? "M " : " L ") + x + " " + y;
    }
    shadow += d + " ";
    u += m.sMin + (m.sMax - m.sMin) * (1 - Math.sin(Math.PI * u));
  }

  // Windward lit face: few long flowing contours wrapping the shoulder and
  // flattening into the trough (connecting to the neighbours).
  const wc1 = [windToe[0] + 0.58 * (peak[0] - windToe[0]), windToe[1]];
  const wc2 = [peak[0] - 0.22 * (peak[0] - windToe[0]), peak[1] - 0.28 * h];
  let wind = "";
  const starts = [0.985, 0.9, 0.78, 0.64].slice(0, m.windN);
  for (const f of starts) {
    const s = cubicPoint(windToe[0], windToe[1], wc1[0], wc1[1], wc2[0], wc2[1], peak[0], peak[1], f);
    const troughLen = 55 + rnd() * 70;
    const ex = windToe[0] - troughLen;
    const c1 = [s.x - 0.42 * (s.x - windToe[0]), s.y + 0.2 * (by - s.y)];
    const c2 = [ex + 0.55 * (windToe[0] - ex), by];
    wind += cubic([s.x, s.y], c1, c2, [ex, by]) + " ";
  }

  const brink = cubic(peak, b1, b2, slipToe);
  return { wind, shadow, brink };
}

// --- assemble the landscape: back skyline -> mid -> bold foreground ---
const layers = [
  { n: 4, by: 56, h: [14, 22], phase: 0.1, ribbonW: 5, sMin: 0.06, sMax: 0.15, windN: 3, lw: 0.7, layer: 0 },
  { n: 5, by: 90, h: [24, 36], phase: 0.55, ribbonW: 9, sMin: 0.045, sMax: 0.12, windN: 4, lw: 0.85, layer: 1 },
  { n: 7, by: 126, h: [30, 46], phase: 0.25, ribbonW: 15, sMin: 0.03, sMax: 0.1, windN: 4, lw: 1.0, layer: 2 },
];

const masses: Mass[] = [];
for (const L of layers) {
  const spacing = W / L.n;
  for (let i = 0; i < L.n; i++) {
    const cx = (i + L.phase) * spacing + (rnd() * 2 - 1) * spacing * 0.14;
    const h = range(L.h[0], L.h[1]);
    masses.push({
      cx: Math.max(60, Math.min(W - 60, cx)),
      by: L.by,
      h,
      ww: h * 4.2 * range(0.9, 1.15),
      ws: h * 1.5 * range(0.9, 1.1),
      layer: L.layer,
      ribbonW: L.ribbonW * range(0.85, 1.15),
      sMin: L.sMin,
      sMax: L.sMax,
      windN: L.windN,
      lw: L.lw,
    });
  }
}
masses.sort((a, b) => a.layer - b.layer || a.cx - b.cx);
const built = masses.map((m) => ({ ...buildMass(m), lw: m.lw, layer: m.layer }));
---

<div class="dunes">
  <svg
    class="dunes-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    {built.map((b) => (
      <g fill="none" stroke="currentColor">
        <path d={b.wind} stroke-width={b.lw.toFixed(2)} vector-effect="non-scaling-stroke" stroke-linecap="round" />
        <path d={b.shadow} stroke-width={b.lw.toFixed(2)} vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
        <path d={b.brink} stroke-width={(b.lw + 0.25).toFixed(2)} vector-effect="non-scaling-stroke" stroke-linecap="round" />
      </g>
    ))}
  </svg>
</div>