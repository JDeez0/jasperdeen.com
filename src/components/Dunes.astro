---
// Layered sand-dune line art for the top of the home page.
//
// Physics-first: each dune has a sharp CREST, a steep dark SLIP FACE right
// below the crest, and a gentle light WINDWARD face toward the next ridge.
// Every shading line is an offset/sheared copy of the crest curve, so lines
// follow the crest's curvature and stay parallel + connected to the dune top.
//
// Density model (graded, not binary):
//   - whole face: horizontal contours + moderate down-right diagonal
//   - slip face (upper band): ADD dense steep down-left + sparse opposite lean
//   → darkest right under the crest, fading to light toward the next ridge.
//
// Generated once at build time into a static SVG (zero runtime JS, crisp at
// any size via non-scaling stroke, currentColor for dark mode).
const W = 1200;
const H = 208;

// core = [from,to] fractions of the strip height occupied by the slip face.
// sC = contour spacing, sH = base diag spacing, sCore = slip spacing,
// sCross = opposite lean in the slip (front dunes only, for deeper shadow).
const layerDefs = [
  { base: 48, amp: 13, f1: 1.5, f2: 3.2, ph1: 0.4, ph2: 1.1, sC: 14, sH: 16, core: [0.03, 0.45], sCore: 6, lxH: 8, lxCore: -10, sCross: 0 },
  { base: 90, amp: 18, f1: 1.9, f2: 3.8, ph1: 2.1, ph2: 0.3, sC: 12, sH: 14, core: [0.03, 0.45], sCore: 5, lxH: 8, lxCore: -10, sCross: 12 },
  { base: 132, amp: 22, f1: 1.6, f2: 3.5, ph1: 3.3, ph2: 2.6, sC: 10, sH: 12, core: [0.03, 0.45], sCore: 4, lxH: 8, lxCore: -11, sCross: 9 },
  { base: 174, amp: 22, f1: 2.2, f2: 4.1, ph1: 0.9, ph2: 4.2, sC: 9, sH: 10, core: [0.03, 0.42], sCore: 3.5, lxH: 8, lxCore: -11, sCross: 7 },
];

const N = 20; // crest anchor samples

// --- crest anchors, enforcing min separation so strips never invert ---
const crests: [number, number][][] = [];
let prevY: number[] | null = null;
for (const L of layerDefs) {
  const pts: [number, number][] = [];
  for (let s = 0; s <= N; s++) {
    const x = (s / N) * W;
    const u =
      Math.sin((x / W) * Math.PI * 2 * L.f1 + L.ph1) +
      0.55 * Math.sin((x / W) * Math.PI * 2 * L.f2 + L.ph2);
    let y = L.base + (L.amp * u) / 1.55;
    if (prevY) y = Math.max(y, prevY[s] + 12);
    y = Math.min(y, H - 8);
    pts.push([x, y]);
  }
  crests.push(pts);
  prevY = pts.map((p) => p[1]);
}

// Gently wavy bottom edge of the band (the front dune's windward toe).
const bottomPts: [number, number][] = crests[3].map(([x]) => [
  x,
  H - 6 + 3.5 * Math.sin((x / W) * Math.PI * 2 * 2.4 + 1.3),
]);

// --- Catmull-Rom -> cubic bezier ---
function splineSegs(pts: [number, number][]): string {
  const n = pts.length;
  let d = "";
  for (let i = 0; i < n - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(n - 1, i + 2)];
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0]} ${p2[1].toFixed(1)}`;
  }
  return d;
}
const splineD = (pts: [number, number][]): string =>
  `M ${pts[0][0]} ${pts[0][1].toFixed(1)}` + splineSegs(pts);

// Region between a top crest and a bottom curve, as a closed clip path.
function clipBetween(top: [number, number][], bot: [number, number][]): string {
  const topD = splineD(top);
  const botD = splineD([...bot].reverse());
  const topSegs = topD.replace(/^M [\d.]+ [\d.]+/, "");
  const botSegs = botD.replace(/^M [\d.]+ [\d.]+/, "");
  const t0 = top[0][1];
  const b0 = bot[0][1];
  const bW = bot[bot.length - 1][1];
  return `M 0 ${b0.toFixed(1)} L 0 ${t0.toFixed(1)} ${topSegs} L ${W} ${bW.toFixed(1)} ${botSegs} Z`;
}

// Offset + laterally sheared copies of the crest — the single mechanism for
// all shading. Lines follow the crest's curvature, so they stay parallel and
// connected to the dune tops.
function shear(
  pts: [number, number][],
  lx: number,
  dy: number,
  start: number,
  count: number,
): string {
  let d = "";
  for (let k = start; k < start + count; k++) {
    const shifted = pts.map(([x, y]) => [x + lx * k, y + dy * k]) as [number, number][];
    d += splineD(shifted) + " ";
  }
  return d;
}

const ridge = (pts: [number, number][], dy: number): [number, number][] =>
  pts.map(([x, y]) => [x, y + dy]) as [number, number][];

const avgGap = (a: [number, number][], b: [number, number][]): number => {
  let s = 0;
  for (let i = 0; i < a.length; i++) s += b[i][1] - a[i][1];
  return s / a.length;
};

// --- build each strip's passes ---
type Strip = {
  id: number;
  clip: string;
  slipClip?: string;
  contours: string;
  baseDiag: string;
  slipDiag?: string;
  slipCross?: string;
};

const strips: Strip[] = [];

for (let i = 0; i < 4; i++) {
  const L = layerDefs[i];
  const top = crests[i];
  const bot = i < 3 ? crests[i + 1] : bottomPts;
  const gap = avgGap(top, bot);

  // Whole face: horizontal contours + moderate down-right diagonal.
  const contours = shear(top, 0, L.sC, Math.round(8 / L.sC) + 1, Math.ceil(gap / L.sC) + 2);
  const baseDiag = shear(top, L.lxH, L.sH, Math.round(6 / L.sH) + 1, Math.ceil(gap / L.sH) + 2);

  const strip: Strip = { id: i, clip: clipBetween(top, bot), contours, baseDiag };

  // Slip face: dense steep down-left + sparse opposite lean.
  const [from, to] = L.core;
  const slipTop = ridge(top, Math.max(3, from * gap));
  const slipBot = ridge(top, to * gap);
  strip.slipClip = clipBetween(slipTop, slipBot);
  strip.slipDiag = shear(top, L.lxCore, L.sCore, Math.round((from * gap) / L.sCore) + 1, Math.ceil(((to - from) * gap) / L.sCore) + 2);
  if (L.sCross > 0) {
    strip.slipCross = shear(top, -L.lxCore, L.sCross, Math.round((from * gap) / L.sCross) + 1, Math.ceil(((to - from) * gap) / L.sCross) + 1);
  }

  strips.push(strip);
}
---

<div class="dunes">
  <svg
    class="dunes-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      {strips.map((s) => (
        <clipPath id={`dune-strip-${s.id}`}>
          <path d={s.clip} />
        </clipPath>
      ))}
      {strips.map((s) =>
        s.slipClip ? (
          <clipPath id={`dune-slip-${s.id}`}>
            <path d={s.slipClip} />
          </clipPath>
        ) : null,
      )}
    </defs>

    {strips.map((s) => (
      <g clip-path={`url(#dune-strip-${s.id})`} fill="none" stroke="currentColor">
        <path d={s.contours} stroke-width="0.9" vector-effect="non-scaling-stroke" />
        <path d={s.baseDiag} stroke-width="0.85" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        {s.slipDiag && s.slipClip ? (
          <g clip-path={`url(#dune-slip-${s.id})`}>
            <path d={s.slipDiag} stroke-width="0.9" vector-effect="non-scaling-stroke" stroke-linecap="round" />
            {s.slipCross && (
              <path d={s.slipCross} stroke-width="0.8" vector-effect="non-scaling-stroke" stroke-linecap="round" />
            )}
          </g>
        ) : null}
      </g>
    ))}

    {/* Crests drawn last so the ridge lines stay crisp over the shading.
        Front (lower) crests slightly heavier = nearer = bolder. */}
    {crests.map((c, i) => (
      <path
        d={splineD(c)}
        fill="none"
        stroke="currentColor"
        stroke-width={(1.15 + 0.15 * i).toFixed(2)}
        stroke-linecap="round"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      />
    ))}
  </svg>
</div>