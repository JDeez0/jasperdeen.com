---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Home page opts out: the hairlined edge moves down under the dune band. */
  noHeaderRule?: boolean;
}

const { title, description, noHeaderRule } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Set the theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS preference.
      (() => {
        try {
          const stored = localStorage.getItem("jd-theme");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class={"site-header" + (noHeaderRule ? " no-rule" : "")}>
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/current/">Current</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <span class="footer-copy">&copy; {new Date().getFullYear()} Jasper H. Deen</span>
        <span class="footer-made">Made with DeepSeek v4 Flash</span>
        <div class="footer-end">
          <span class="footer-art">Banner by <a href="https://fiverr.com/stengahsadar" target="_blank" rel="noopener">Toha</a>.</span>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle light and dark mode"
            title="Toggle light / dark mode"
          >
            <svg class="icon-moon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M13.5 9.7A6 6 0 0 1 6.3 2.5a6 6 0 1 0 7.2 7.2Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linejoin="round"
              />
            </svg>
            <svg class="icon-sun" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.25" />
              <path
                d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M12.95 3.05l-1.42 1.42M4.47 11.53l-1.42 1.42"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>
      </footer>
    </div>

    <script>
      // Pinned conversation, revealed purely by scroll progress — no timers.
      // The chat section (.chat) is a tall RUNWAY. Its contents (.pin) are
      // sticky to the viewport top, so once "Building a space…" arrives at
      // the top it STAYS there and the page keeps accepting scroll while the
      // conversation doesn't move. New messages reveal from how far the
      // runway has been consumed, stacking below the pinned first bubble.
      // Each message demands STEP px of extra scroll (super-staggered).
      // Reveal is a ONE-WAY LATCH: once shown, a bubble never hides again
      // (until page refresh). Scrolling UP past the high-water mark releases
      // the sticky pin entirely (one-way): the page becomes a normal flowing
      // document, bubbles keep their positions, and any not-yet-revealed
      // bubble reveals as it enters the viewport. The rAF loop below is the
      // scroll mechanism ON PURPOSE: on iOS, scroll events don't fire during
      // momentum, but scrollY does update — polling is the reliable pattern.
      // With JS off this is a normal page with all text visible; reduced-
      // motion still runs the progressive reveal but with a gentle fade
      // (see global.css).
      const messages = Array.from(document.querySelectorAll(".message"));
      const chat = document.querySelector<HTMLElement>(".chat");

      if (messages.length > 0 && chat) {
        document.documentElement.classList.add("js-scrub");

        // Distance model (all in px of absolute page scroll):
        //   The reveals start when the QUESTION reaches the TOP THIRD of the
        //   viewport (questionDoc − vh/3), not when it pins at the very top.
        //   The FIRST bubble flies in LEAD px after that; every message after
        //   waits STEP more than the one before it. No timers: distance IS
        //   scroll amount.
        //   Threshold for message i:  anchor + LEAD + i × STEP
        const LEAD = 60;   // a little extra before the first bubble
        const STEP = 200;  // scroll distance between messages after the first
        const TRAIL = 40; // scroll left after the last reveal
        const RELEASE_UP = 10; // px of upward scroll past the peak that releases the pin
        const n = messages.length;
        // vh is `let` because it must track the window: every threshold and
        // the runway height are derived from it (see the resize handler).
        let vh = window.innerHeight || document.documentElement.clientHeight;
        const arrow = document.querySelector(".scroll-indicator");

        // Absolute scroll position where the question sits at the TOP TWO-
        // FIFTHS (vh × 0.4) of the viewport — slightly earlier than the
        // previous top-third. That's when the conversation begins revealing.
        //
        // Must be measured AFTER layout is settled. On a COLD first load the
        // script can run before web fonts / async CSS are applied, so a
        // one-time read of question.getBoundingClientRect() yields a wrong
        // (too-large) anchor and reveals fire late (only when the question
        // reaches the very top). Refresh fixes it because fonts/CSS are
        // cached. We therefore re-measure once fonts are ready and again on
        // window load, guarded so we only trust measurements taken near the
        // top of the page (after the sticky pin engages, the question's
        // document offset stops being scroll-invariant).
        const question = document.querySelector<HTMLElement>(".question");
        const pinEl = document.querySelector<HTMLElement>(".pin");
        // The pin's NATURAL flow offset inside the chat, captured before
        // the sticky pin ever engages. Once stuck, offsetTop reports the
        // STUCK position (it grows with scroll), so it must not be read
        // later — the resize handler relies on this stable value.
        const pinNaturalTop = pinEl?.offsetTop ?? 0;
        const footerEl = document.querySelector(".site-footer");
        let footerH = 0; // measured in plan(), used by release()
        // The pin's sticky offset (CSS: top: 1.5rem). While STUCK, the pin's
        // viewport top equals this value exactly — used to detect engagement.
        const stickyTop = pinEl ? parseFloat(getComputedStyle(pinEl).top) || 24 : 24;
        // One-way state (until refresh). peak starts at the load-time scroll
        // position so a mid-page load (refresh, back-nav scroll restoration)
        // never fires an instant release; iOS rubber-band can push scrollY
        // negative, so every read is clamped before use.
        let peak = Math.max(0, window.pageYOffset || window.scrollY || 0);
        let released = false;
        // While true, the released page holds a small reveal pad under the
        // conversation so there is always a little scroll room to trigger the
        // down-gated reveals (on fits-screens the collapsed page would
        // otherwise land at max-scroll with zero room). Cleared the moment
        // every bubble is shown, so the pad doesn't linger as a gap.
        let awaitingPad = false;
        const REVEAL_ROOM = 120; // px of scroll room kept during the reveal
        // The previous frame's scrollY, used ONLY as a downward-motion gate
        // after release: post-release reveals must be triggered by the user
        // actively scrolling DOWN, never by the release itself or by upward
        // scroll (which would instantly fly in every hidden bubble as the
        // runway collapse pulls rows into the reading band).
        let prevScrollY = Math.max(0, window.pageYOffset || window.scrollY || 0);

        // One-way pin release: un-stick the pin and collapse the runway to the
        // NATURAL page layout (conversation then footer), once, at release
        // time. The page is then a fixed-height normal document — no later
        // layout reflow, so there is no blank runway slab and no snap-back.
        // Anchored to whichever element the user is actually looking at:
        //  · the pin, when the conversation is still on screen (mid-read
        //    release) — it keeps its exact viewport position (zero jump); or
        //  · the footer, when it was on screen before the collapse (released
        //    from the very end) — the footer stays put.
        // Post-release reveals are VIEWPORT-ENTRY + down-scroll gated (see
        // apply()): a bubble shows only once its row actually enters the
        // reading band while the user scrolls DOWN. This is what keeps hidden
        // bubbles hidden during the upward scroll that triggered the release.
        const release = () => {
          if (released || !pinEl || !chat) return;
          released = true;
          const y = Math.max(0, window.pageYOffset || window.scrollY || 0);
          // How far the pin sits BELOW its natural flow slot right now.
          const shift =
            pinEl.getBoundingClientRect().top -
            chat.getBoundingClientRect().top -
            pinNaturalTop;
          const anyHidden = messages.some((m) => !(m as { __shown?: boolean }).__shown);
          // Collapse to natural in EVERY case.
          pinEl.style.paddingBottom = ""; // drop the short-screen release padding
          // Release BOTH the shaved reservation (plan()) AND the CSS base
          // min-height: 100svh. Clearing to "" would fall back to that CSS
          // rule and leave a full viewport of dead space under the last
          // bubble after release — the 'mystery gap before the footer' on
          // the second scroll-down. 0 lets the pin shrink to its content.
          pinEl.style.minHeight = "0";
          pinEl.style.position = "static";
          chat.style.height = ""; // collapse the runway: natural page layout
          // ── Release anchor ─────────────────────────────────────────
          // Anchor whichever element the user is actually LOOKING at:
          //  · the pin, when the conversation is still on screen — it
          //    keeps its exact viewport position; or
          //  · the footer, when it is on screen (released from the end) —
          //    the footer stays at its exact viewport position.
          const naturalDocH = document.documentElement.scrollHeight;
          const footVp = footerEl ? footerEl.getBoundingClientRect().top : vh;
          let anchorScroll = y - shift; // pin-anchored (default)
          if (footVp < vh - 8) {
            anchorScroll = (naturalDocH - footerH) - footVp;
          }
          window.scrollTo(0, Math.max(0, anchorScroll));
          // Clamp safety: only reachable near the very bottom of the page.
          const k = Math.max(0, anchorScroll + vh - document.documentElement.scrollHeight);
          if (k > 0) window.scrollTo(0, anchorScroll - k);
          (window as any).__jd = {
            ...(window as any).__jd,
            released: true,
            releasedAt: Math.round(y),
          };
          // Keep a little scroll room for the down-scroll reveals (see
          // awaitingPad / apply()). Added AFTER the anchor scroll so the
          // release never lands flush at max-scroll on fits-screens. Uses
          // padding-bottom (not min-height): the conversation content is
          // taller than any min-height here, so min-height would do nothing;
          // padding adds real room BELOW the last bubble, pushing the footer
          // down by REVEAL_ROOM until every bubble has shown.
          if (anyHidden) {
            pinEl.style.paddingBottom = REVEAL_ROOM + "px";
            awaitingPad = true;
          }
        };

        // ─────────────────────────────────────────────────────────────
        // RELEASE PLANNER.
        // On a tall viewport every bubble fits inside the pinned screen
        // and the baseline ladder/runway is used unchanged. On a shorter
        // viewport some bubble would fly up BELOW the fold — invisible.
        // For those sizes this planner computes, from real layout
        // measurements, the scroll position at which the sticky pin must
        // let go (the RELEASE LINE): the threshold of the first bubble
        // that cannot fit. The runway is sized so the pin runs out of
        // sticky room at exactly that line (CSS does the releasing — no
        // JS state machine), the bubble stack gets extra bottom padding
        // so enough scroll remains after release, and the thresholds of
        // the too-tall bubbles are DELAYED by their measured overflow, so
        // each one flies only once it has scrolled fully into view. Every
        // bubble therefore appears on-screen, at every window size.
        // ─────────────────────────────────────────────────────────────
        const FIT_MARGIN = 40;    // bubble must clear the fold by this much
        const MIN_SPACING = 120;  // never let two reveals get closer than this
        let anchor = 0;           // scroll position of the reveal start line
        let thresholds: number[] = [];
        let releaseLine: { at: number; bubble: number } | null = null;

        const plan = () => {
          if (released || !pinEl || !question) return;
          // All measurements are layout-derived (offsetTop/offsetHeight are
          // immune to both scroll position and the reveal transforms), so
          // this is valid at ANY scroll position and safe to re-run.
          const chatTopDoc =
            chat.getBoundingClientRect().top + (window.scrollY || 0);
          anchor = chatTopDoc + pinNaturalTop + question.offsetTop - vh * 0.4;
          const chatPad =
            parseFloat(getComputedStyle(chat).paddingBottom) || 0;
          footerH = footerEl
            ? (footerEl as HTMLElement).offsetHeight
            : 0;
          // The pin does NOT need to reserve a full viewport. Its minimum
          // height only has to keep everything after the chat (the footer)
          // below the fold while the screen is frozen, and leave exactly
          // enough room for that content to be fully revealed at page end:
          // viewport − (chatPad + stickyTop + footer height). Reserving the
          // FULL viewport over-provides by those ~165px, which is the
          // "large gap" between the last bubble and the footer on
          // fits-screens (conversation shorter than the viewport).
          const reserved =
            chatPad + stickyTop + (footerH || 0);
          // Shrink the pin's reservation accordingly (CSS keeps 100svh as
          // the no-JS default).
          pinEl.style.minHeight =
            Math.max(vh - reserved, 0) + "px";
          const stack = (messages as HTMLElement[]).map((m) => ({
            off: m.offsetTop,
            h: m.offsetHeight,
          }));
          const restBottom = (k: number, top: number) =>
            top + stack[k].off + stack[k].h;
          const contentH = stack[n - 1].off + stack[n - 1].h;

          // First bubble whose resting spot would not clear the fold while
          // pinned. Monotone: offsets only grow, so this is well-defined.
          let kstar = -1;
          for (let k = 0; k < n; k++) {
            if (restBottom(k, stickyTop) > vh - FIT_MARGIN) {
              kstar = k;
              break;
            }
          }

          if (kstar <= 0) {
            // Tall screen — everything fits (or bubble №0, which flies
            // before the pin engages, is the first non-fitter): baseline
            // behavior, no release.
            thresholds = messages.map((_, k) => anchor + LEAD + k * STEP);
            pinEl.style.paddingBottom = "";
            releaseLine = null;
            chat.style.height = anchor + LEAD + n * STEP + TRAIL + "px";
            (window as any).__jd = {
              thresholds: [...thresholds],
              releaseLine: null,
              anchor,
            };
            return;
          }

          // Release line: the threshold of the first non-fitting bubble.
          // (kstar >= 1 is always past the pin-engage point — see the
          // threshold math — so there is something to release.)
          const U = anchor + LEAD + kstar * STEP;
          const overflow = (k: number) =>
            restBottom(k, stickyTop) - (vh - FIT_MARGIN);
          const overflowLast = overflow(n - 1);

          // Extra scroll after the pin releases = pin height + pads + footer
          // − viewport. Make sure at least DESIRED_TAIL of it remains after
          // the last bubble becomes visible, via bottom padding on the pin
          // (invisible while pinned — it sits below the fold).
          const budget = (h: number) =>
            h + stickyTop + chatPad + footerH - vh;
          const pinH0 = Math.max(vh - reserved, contentH);
          const pinPad = Math.max(
            0,
            Math.min(
              600,
              Math.round(overflowLast + 60 - budget(pinH0))
            )
          );
          const pinH = Math.max(vh - reserved, contentH + pinPad);
          pinEl.style.paddingBottom = pinPad + "px";

          // Delayed thresholds: each too-tall bubble flies once the slid-up
          // pin has carried it fully into view; keep the original ladder
          // when it is later, and keep a minimum rhythm between reveals.
          const t = [];
          let prev = -Infinity;
          for (let k = 0; k < n; k++) {
            let v =
              k < kstar
                ? anchor + LEAD + k * STEP
                : Math.max(anchor + LEAD + k * STEP, U + overflow(k));
            v = Math.max(v, prev + MIN_SPACING);
            t.push(v);
            prev = v;
          }
          thresholds = t;
          releaseLine = { at: Math.round(U), bubble: kstar };
          // Publish the plan so the annotated-site overlay (and anything
          // else) can read the REAL thresholds instead of re-deriving them.
          (window as any).__jd = {
            thresholds: [...thresholds],
            releaseLine: { ...releaseLine },
            anchor,
          };

          // Runway sized so natural sticky exhaustion happens at exactly U:
          // unstick scrollY = chatTop + (chatHeight − chatPad) − pinH − top.
          chat.style.height =
            U + pinH + stickyTop + chatPad - chatTopDoc + "px";
        };

        const refreshLayout = () => {
          requestAnimationFrame(plan);
        };
        plan();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(refreshLayout).catch(() => {});
        }
        window.addEventListener("load", refreshLayout);

        // RESIZE: the whole plan is layout-derived, valid at any scroll
        // position, so a resize just recomputes it against the new window
        // height. Debounced so a drag-resize measures once. On mobile,
        // innerHeight churns as the URL bar collapses/expands DURING scroll
        // and fires spurious resizes — so height-only changes are ignored:
        // the plan is only recomputed when the viewport SHAPE (width)
        // changes. Once released, the layout is natural and frozen.
        let resizeTimer = 0;
        let lastW = window.innerWidth;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            const newVh = window.innerHeight || document.documentElement.clientHeight;
            const newW = window.innerWidth;
            if (released || !question || !chat || newVh === vh || newW === lastW) return;
            lastW = newW;
            vh = newVh;
            plan();
          }, 150);
        });

        // Post-release viewport-entry reveals measure the ROW, not the
        // bubble: the bubble carries the 44vh entrance transform, and
        // getBoundingClientRect INCLUDES transforms, so measuring the bubble
        // would trigger ~44vh late. The row is never transformed.
        const rows = messages.map((el) => el.parentElement);

        const apply = () => {
          const scrollY = Math.max(0, window.pageYOffset || window.scrollY || 0);
          // The fixed arrow fades out as the user nears the end of the page.
          if (arrow) {
            const nearBottom =
              scrollY >= ((document.documentElement || document.body).scrollHeight - vh - 120);
            arrow.classList.toggle("is-hidden", nearBottom);
          }
          if (!released) {
            peak = Math.max(peak, scrollY);
            // Release on meaningful upward scroll, but only once the pin is
            // actually stuck (its viewport top equals the sticky offset; in
            // the hero it sits lower, so early jitter can't trigger it).
            if (
              peak - scrollY > RELEASE_UP &&
              pinEl &&
              pinEl.getBoundingClientRect().top <= stickyTop + 1
            ) {
              release();
            }
          }
          for (let i = 0; i < n; i++) {
            const el = messages[i] as HTMLElement & { __shown?: boolean };
            if (el.__shown) continue; // one-way latch: never un-reveal
            let show = false;
            if (!released) {
              // Pinned: reveal by SCROLL THRESHOLD. The one-way latch +
              // threshold comparison mean an upward scroll can never reveal a
              // bubble (thresholds are crossed only by scrolling down).
              show = scrollY >= (thresholds[i] ?? anchor + LEAD + i * STEP);
            } else {
              // Released (the runway is already collapsed to the natural
              // page): reveal by VIEWPORT-ENTRY, and only while the user is
              // actively scrolling DOWN (scrollY rising since the last
              // frame). Arbitrary hidden rows must stay unappeared during
              // the upward scroll that triggered the release and until the
              // user scrolls back down and each row re-enters the reading
              // band — this is the fix for "scrolling up made every hidden
              // bubble appear at once" AND for the blank/snap that came
              // from keeping threshold reveals on a page that no longer
              // stays pinned (the conversation scrolls off, revealing
              // invisible bubbles and leaving an empty runway, then jumping
              // back when the last threshold finally fires).
              const row = rows[i];
              if (row) {
                const t = row.getBoundingClientRect().top;
                const b = row.getBoundingClientRect().bottom;
                show = scrollY > prevScrollY && t < vh - 40 && b > 0;
              }
            }
            if (show) {
              el.__shown = true;
              el.classList.add("revealed");
            }
          }
          // Once every bubble is shown, drop the reveal pad so the footer
          // sits right under the last bubble (no lingering gap). Gentle: the
          // pad is only ~REVEAL_ROOM px.
          if (
            released &&
            awaitingPad &&
            messages.every((m) => !!(m as { __shown?: boolean }).__shown)
          ) {
            awaitingPad = false;
            if (pinEl) pinEl.style.paddingBottom = "";
          }
          // Keep the gate state for the next frame.
          prevScrollY = scrollY;
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }

      // Theme toggle: flips data-theme on <html> and remembers the choice.
      const toggle = document.querySelector(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("jd-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>