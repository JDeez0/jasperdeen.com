---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // Timed spring pop, triggered by scroll position. Each frame we read
      // each message's live viewport position and toggle a .revealed class
      // (see global.css), whose CSS transition flies the bubble up + fades
      // it in over ~0.45s with an iMessage-style overshoot — "scroll slowly,
      // text flies up quickly." Scrolling back out reverses it (fly-out).
      // State is a pure function of position, so every pass is identical.
      //
      // With JS off or prefers-reduced-motion set, nothing runs and all
      // text is simply visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const messages = Array.from(document.querySelectorAll(".message"));

      if (!prefersReducedMotion && messages.length > 0) {
        document.documentElement.classList.add("js-scrub");

        // Position-driven state machine. Each frame we compute, from the
        // message's LIVE position, whether it should be revealed:
        //   fly IN  once its top rises past a line ~160px above the viewport
        //           bottom (with a little hysteresis so it can't thrash),
        //   fly OUT once it falls back below ~100px above the bottom, or
        //           fully leaves the top.
        // The actual motion is a CSS transition (see global.css) that pops
        // the bubble up in ~0.45s regardless of scroll speed — "scroll slowly,
        // text flies up quickly." State is a pure function of position, so
        // every pass is identical and scrolling up cleanly reverses it.
        const apply = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          for (const el of messages) {
            const row = el.parentElement
              ? el.parentElement.getBoundingClientRect()
              : el.getBoundingClientRect();
            const inBand = row.top < vh - 160 && row.bottom > 40;
            const outBand = row.top > vh - 100 || row.bottom < 0;
            if (!el.__shown && inBand) {
              el.__shown = true;
              el.classList.add("revealed");
            } else if (el.__shown && outBand) {
              el.__shown = false;
              el.classList.remove("revealed");
            }
          }
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }
    </script>
  </body>
</html>