---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Set the theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS preference.
      (() => {
        try {
          const stored = localStorage.getItem("jd-theme");
          const theme =
            stored === "dark" || stored === "light"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Jasper Deen" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/current/">Current</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Toggle light and dark mode"
          title="Toggle light / dark mode"
        >
          <svg class="icon-moon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              d="M13.5 9.7A6 6 0 0 1 6.3 2.5a6 6 0 1 0 7.2 7.2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linejoin="round"
            />
          </svg>
          <svg class="icon-sun" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.25" />
            <path
              d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M12.95 3.05l-1.42 1.42M4.47 11.53l-1.42 1.42"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </footer>
    </div>

    <script>
      // ── Pinned conversation, metered reveal ─────────────────────
      // The chat section (.chat) is a tall RUNWAY; its contents (.pin) are
      // sticky, so the conversation freezes and the page keeps scrolling.
      // Bubbles reveal as the METERED scroll position (viewY) crosses their
      // thresholds — and during the reveal phase, viewY chases the user's
      // real scroll position at a capped speed (REVEAL_RATE). A fast flick
      // therefore unfolds the conversation at the same readable pace as a
      // slow scroll, AND cannot reach the bottom before the last bubble has
      // appeared (the thresholds are crossed by the metered position, which
      // crawls at one bubble per REVEAL_MS). Upward scroll is immediate,
      // which is what triggers the one-way pin release. The rAF loop is the
      // scroll mechanism ON PURPOSE: on iOS, scroll events don't fire during
      // momentum, but scrollY does update — polling is the reliable pattern.
      // With JS off this is a normal page with all text visible.
      const messages = Array.from(document.querySelectorAll(".message"));
      const chat = document.querySelector<HTMLElement>(".chat");

      if (messages.length > 0 && chat) {
        document.documentElement.classList.add("js-scrub");

        const LEAD = 60;   // a little extra before the first bubble
        const STEP = 200;  // scroll distance between messages
        const TRAIL = 40;  // runway left after the last reveal
        const REVEAL_MS = 500;                  // desired per-bubble pace
        const REVEAL_RATE = STEP / REVEAL_MS;   // px/ms the view may crawl
        const RELEASE_UP = 10;  // px of upward scroll that releases the pin
        const n = messages.length;
        let vh = window.innerHeight || document.documentElement.clientHeight;
        const arrow = document.querySelector(".scroll-indicator");

        const question = document.querySelector<HTMLElement>(".question");
        const pinEl = document.querySelector<HTMLElement>(".pin");
        const footerEl = document.querySelector(".site-footer");
        const pinNaturalTop = pinEl?.offsetTop ?? 0;
        const stickyTop = pinEl ? parseFloat(getComputedStyle(pinEl).top) || 24 : 24;
        let peak = Math.max(0, window.pageYOffset || window.scrollY || 0);
        let released = false;
        // Metered view position: during the reveal phase this chases the
        // user's native scrollY at REVEAL_RATE (px/ms). Reveals and the
        // release trigger are driven by THIS, not the raw scroll — that is
        // what makes fast and slow scroll feel identical.
        let viewY = Math.max(0, window.pageYOffset || window.scrollY || 0);
        let lastFrame = performance.now();
        // Reveal-phase scroll range (recomputed in plan()).
        let revealStart = 0;
        let revealEnd = 0;
        // One-way reveal latch (type-safe replacement for el.__shown).
        const shown = new WeakSet<Element>();
        // Planner state.
        let anchor = 0;
        let thresholds: number[] = [];
        let releaseLine: { at: number; bubble: number } | null = null;
        let fitsMode = false;
        let overflowVals: number[] = [];
        let footerH = 0;

        // One-way pin release: unwind the pin to the NATURAL page layout.
        // Anchor whichever element the user is actually LOOKING at: the pin
        // when the conversation is on screen (mid-reveal release), or the
        // footer when it has scrolled away (release from the end) — the
        // grown runway collapses, so anchoring the pin there would drift
        // the footer by the collapsed delta.
        const release = () => {
          if (released || !pinEl || !chat) return;
          released = true;
          const y = Math.max(0, window.pageYOffset || window.scrollY || 0);
          const shift =
            pinEl.getBoundingClientRect().top -
            chat.getBoundingClientRect().top -
            pinNaturalTop;
          pinEl.style.paddingBottom = "";
          pinEl.style.minHeight = "0px";
          pinEl.style.position = "static";
          chat.style.height = ""; // collapse the runway: natural layout
          const naturalDocH = document.documentElement.scrollHeight;
          const footVp = footerEl.getBoundingClientRect().top;
          let anchorScroll = y - shift; // pin-anchored (mid-hold release)
          if (footVp < vh - 8) {
            // The footer is on screen — anchor it at its exact viewport
            // position so the user's view doesn't jump.
            anchorScroll = (naturalDocH - footerH) - footVp;
          }
          window.scrollTo(0, Math.max(0, anchorScroll));
          const k = Math.max(0, anchorScroll + vh - document.documentElement.scrollHeight);
          if (k > 0) window.scrollTo(0, anchorScroll - k);
          (window as any).__jd = {
            ...(window as any).__jd,
            released: true,
            releasedAt: Math.round(y),
          };
        };

        // ── PLAN ────────────────────────────────────────────────────
        // Layout-derived; re-runs on load/fonts/resize. Computes the anchor,
        // the ladder thresholds, and — on short screens where some bubbles
        // cannot clear the fold while pinned — the release line and delayed
        // thresholds so the slid-up pin carries them into view.
        const plan = () => {
          if (!pinEl || !question) return;
          const chatTopDoc =
            chat.getBoundingClientRect().top + (window.scrollY || 0);
          anchor = chatTopDoc + pinNaturalTop + question.offsetTop - vh * 0.4;
          const chatPad = parseFloat(getComputedStyle(chat).paddingBottom) || 0;
          footerH = footerEl ? (footerEl as HTMLElement).offsetHeight : 0;
          const stack = (messages as HTMLElement[]).map((m) => ({
            off: m.offsetTop,
            h: m.offsetHeight,
          }));
          const restBottom = (k: number, top: number) =>
            top + stack[k].off + stack[k].h;
          const contentH = stack[n - 1].off + stack[n - 1].h;
          const reserved = chatPad + stickyTop + footerH;
          // Shave the pin's viewport reservation (the full 100svh
          // over-provides by exactly this amount on fits-screens).
          pinEl.style.minHeight = Math.max(vh - reserved, 0) + "px";

          let kstar = -1;
          for (let k = 0; k < n; k++) {
            if (restBottom(k, stickyTop) > vh - FIT_MARGIN) { kstar = k; break; }
          }
          fitsMode = kstar <= 0;

          // The reveal phase spans the whole ladder; the metered view
          // crawls through it at REVEAL_RATE.
          revealStart = thresholds.length ? thresholds[0] : anchor + LEAD;
          thresholds = messages.map((_, k) => anchor + LEAD + k * STEP);
          revealStart = thresholds[0] - LEAD;
          revealEnd = thresholds[n - 1] + TRAIL;

          if (fitsMode) {
            pinEl.style.paddingBottom = "";
            releaseLine = null;
            // Full-ladder runway: the native scroll has room for the whole
            // sequence; the metered view is what paces the reveal.
            chat.style.height = thresholds[n - 1] + TRAIL + vh - chatTopDoc + "px";
            (window as any).__jd = { thresholds: [...thresholds], releaseLine: null, anchor };
            return;
          }

          // Short screen: the planner releases the pin at the first bubble
          // that cannot fit, then the slid-up pin carries the rest into
          // view (delayed thresholds, position-coupled to the slide).
          const U = anchor + LEAD + kstar * STEP;
          const overflow = (k: number) => restBottom(k, stickyTop) - (vh - FIT_MARGIN);
          overflowLast = overflow(n - 1);
          const budget = (h: number) => h + stickyTop + chatPad + footerH - vh;
          const pinH0 = Math.max(vh - reserved, contentH);
          const pinPad = Math.max(0, Math.min(600, Math.round(overflow(n - 1) + 60 - budget(pinH0))));
          const pinH = Math.max(vh - reserved, contentH + pinPad);
          pinEl.style.paddingBottom = pinPad + "px";
          const t = [];
          let prev = -Infinity;
          for (let k = 0; k < n; k++) {
            let v = k < kstar
              ? anchor + LEAD + k * STEP
              : Math.max(anchor + LEAD + k * STEP, U + overflow(k));
            v = Math.max(v, prev + MIN_SPACING);
            t.push(v); prev = v;
          }
          thresholds = t;
          releaseLine = { at: Math.round(U), bubble: kstar };
          (window as any).__jd = { thresholds: [...thresholds], releaseLine: { ...releaseLine }, anchor };
          // The reveal phase on short screens ends at the last delayed
          // threshold; past it the pin is exhausted and the footer scrolls.
          revealEnd = thresholds[n - 1] + TRAIL;
          chat.style.height = U + pinH + stickyTop + chatPad - chatTopDoc + "px";
        };

        const refreshLayout = () => { requestAnimationFrame(plan); };
        plan();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(refreshLayout).catch(() => {});
        }
        window.addEventListener("load", refreshLayout);

        // RESIZE: height-only changes are mobile URL-bar noise; replan on
        // width changes only. Once released, layout is natural and frozen.
        let resizeTimer = 0;
        let lastW = window.innerWidth;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            const newVh = window.innerHeight || document.documentElement.clientHeight;
            const newW = window.innerWidth;
            if (released || !question || !chat || newVh === vh || newW === lastW) return;
            lastW = newW; vh = newVh;
            viewY = Math.min(viewY, document.documentElement.scrollHeight - vh);
            plan();
          }, 150);
        });

        // Metered view + reveal loop.
        const rows = messages.map((el) => el.parentElement);
        // (shown, viewY, lastFrame declared in the state block above.)

        const apply = () => {
          const now = performance.now();
          const dt = Math.min(50, now - lastFrame);
          lastFrame = now;
          const nativeY = Math.max(0, window.pageYOffset || window.scrollY || 0);
          let scrollY: number;
          if (!released && nativeY > revealStart && viewY < revealEnd) {
            // Reveal phase: the metered view chases the native scroll at
            // REVEAL_RATE — a fast flick decelerates to one bubble per
            // REVEAL_MS; slow scroll tracks 1:1 (nativeY < viewY + dt*rate).
            if (nativeY > viewY) {
              viewY = Math.min(viewY + REVEAL_RATE * dt, nativeY);
            } else {
              viewY = nativeY; // upward scroll: immediate (release path)
            }
            scrollY = viewY;
            const native = Math.round(nativeY);
            if (Math.round(window.scrollY) !== Math.round(scrollY)) {
              window.scrollTo(0, Math.round(scrollY));
            }
          } else {
            viewY = nativeY;
            scrollY = nativeY;
          }
          if (arrow) {
            const nearBottom = scrollY >= (document.documentElement.scrollHeight - vh - 120);
            arrow.classList.toggle("is-hidden", nearBottom);
          }
          if (!released) {
            peak = Math.max(peak, scrollY);
            if (peak - scrollY > RELEASE_UP && pinEl &&
                pinEl.getBoundingClientRect().top <= stickyTop + 1) {
              release();
            }
          }
          for (let i = 0; i < n; i++) {
            const el = messages[i];
            if (shown.has(el)) continue; // one-way latch: never un-reveal
            let show = false;
            if (!released) {
              show = scrollY >= (thresholds[i] ?? anchor + LEAD + i * STEP);
            } else {
              const row = rows[i];
              show = !!row && row.getBoundingClientRect().top < vh - 40;
            }
            if (show) {
              shown.add(el);
              el.classList.add("revealed");
            }
          }
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }

      // Theme toggle: flips data-theme on <html> and remembers the choice.
      const toggle = document.querySelector(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("jd-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>