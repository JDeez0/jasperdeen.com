---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
    <header class="site-header">
      <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
      <nav class="site-nav" aria-label="Site">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
    </footer>
    </div>

    <script>
  // Fallback for browsers without CSS scroll-driven animations
  // (animation-timeline: view()). When active, messages reveal via
  // IntersectionObserver instead. Always respects prefers-reduced-motion:
  // users who reduce motion see all text statically, by design.
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const supportsViewTimeline =
    typeof CSS !== "undefined" &&
    typeof CSS.supports === "function" &&
    CSS.supports("animation-timeline: view()");

  if (!prefersReducedMotion && !supportsViewTimeline) {
    const messages = document.querySelectorAll(".message");
    if (messages.length > 0) {
      document.documentElement.classList.add("io-anim");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const el = entry.target;
              if (entry.isIntersecting) {
                // In view: fly in (this also re-fires when scrolling back
                // down after the message had faded out).
                el.classList.remove("out");
                el.classList.add("revealed");
              } else if (el.classList.contains("revealed")) {
                // Left the viewport (scroll up or down): reverse-fly out.
                // Never-revealed messages stay untouched (no flash).
                el.classList.remove("revealed");
                el.classList.add("out");
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
        );
        messages.forEach((message) => observer.observe(message));
      } else {
        // Ancient browser: show everything immediately.
        messages.forEach((message) => message.classList.add("revealed"));
      }
    }
  }
    </script>
  </body>
</html>