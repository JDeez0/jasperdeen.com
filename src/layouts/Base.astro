---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // Seamless scroll-scrub fallback for browsers WITHOUT CSS scroll-driven
      // animations (animation-timeline: view()). Mimics the CSS path exactly:
      // each message's progress is driven 1:1 by its own position in the
      // viewport, so scrolling up reverses it and every pass looks identical —
      // no timed "fly-in" that can lag, skip, or fire twice.
      //
      // Progress mapping (matches the CSS 0/10/90/100 keyframes):
      //   - while the message travels its [entry → exit] band, read
      //     `entryDistance / screen` as raw progress
      //   - convert: [0  → 0.10]   => fly in  (opacity 0→1, translateY 26px→0,
      //                                        scale .95→1, spring overshoot)
      //   -          [0.10→0.90]   => fully visible
      //   -          [0.90→1.00]   => fly out (mirror of fly-in)
      //
      // Reads only transform + opacity (GPU-composited), on rAF; respects
      // prefers-reduced-motion (no class → static text). If IntersectionObserver
      // is missing, messages simply stay visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const supportsViewTimeline =
        typeof CSS !== "undefined" &&
        typeof CSS.supports === "function" &&
        CSS.supports("animation-timeline: view()");

      const messages = Array.from(document.querySelectorAll(".message"));
      if (
        !prefersReducedMotion &&
        !supportsViewTimeline &&
        messages.length > 0 &&
        typeof requestAnimationFrame === "function"
      ) {
        document.documentElement.classList.add("js-scrub");

        // Read LIVE geometry every frame (getBoundingClientRect is
        // viewport-relative — caching it would freeze progress at load).
        const apply = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          for (const el of messages) {
            // Read the PARENT's rect (untransformed, stable): the message's
            // own rect is shifted by its translateY/scale animation.
            const row = el.parentElement
              ? el.parentElement.getBoundingClientRect()
              : el.getBoundingClientRect();
            // Nothing near the viewport: leave it wherever it is (optimization).
            if (row.bottom < 0 || row.top > vh) continue;
            // Same math as the CSS animation-timeline: view() with
            // range cover 0% cover 100%:
            //   raw = 0 while fully below the viewport,
            //   raw = 1 once fully exited past the top.
            const raw = Math.max(0, Math.min(1, (vh - row.top) / (vh + row.height)));
            let p;
            if (raw <= 0.1) {
              p = raw / 0.1; // fly-in ramp 0..1 (mirrors keyframes 0-10%)
            } else if (raw >= 0.9) {
              p = (1 - raw) / 0.1; // fly-out mirror 1..0 (keyframes 90-100%)
            } else {
              p = 1; // fully visible plateau (keyframes 10-90%)
            }
            // Spring overshoot easing — same cubic-bezier(0.34,1.56,0.64,1)
            // (easeOutBack) the CSS keyframes use, applied to opacity and
            // transform so both paths render identically.
            const c1 = 1.70158;
            const c3 = c1 + 1;
            const t = 1 + c3 * Math.pow(p - 1, 3) + c1 * Math.pow(p - 1, 2);
            const opacity = Math.min(1, t);
            el.style.opacity = String(opacity);
            el.style.transform = `translateY(${(1 - t) * 26}px) scale(${1 - (1 - t) * 0.05})`;
          }
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }
      // No rAF: leave messages static (all visible).
    </script>
  </body>
</html>