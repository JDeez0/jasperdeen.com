---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // One mechanism for the fly-up reveal: a tiny per-frame scroll-scrub
      // that drives each message's opacity/transform from its LIVE viewport
      // position (cover-range math: 0% fully below the fold → 100% fully
      // exited past the top, with a fast springy pop-in on the first 10% and
      // a mirrored fly-out on the last 10%). Scrolling up reverses it, every
      // pass is identical, and it works in every engine. We deliberately do
      // NOT rely on CSS animation-timeline: Firefox 154 advertises support
      // but mis-renders the range keyframes (messages stay static).
      //
      // When JS is off or prefers-reduced-motion is set, nothing runs and
      // all text is simply visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const messages = Array.from(document.querySelectorAll(".message"));

      // ---- DEV-ONLY diagnostic badge (never ships in production) ----
      if (import.meta.env.DEV) {
        const badge = document.createElement("div");
        badge.id = "jd-diag";
        badge.style.cssText =
          "position:fixed;left:8px;bottom:8px;z-index:9999;font:11px/1.5 monospace;" +
          "background:rgba(0,0,0,.8);color:#0f0;padding:4px 8px;border-radius:4px;" +
          "pointer-events:none;white-space:pre";
        const mk = () =>
          (badge.textContent =
            [
              "RM(no-pref/off): " + (prefersReducedMotion ? "REDUCE-ON" : "off"),
              "scrub: " + (document.documentElement.classList.contains("js-scrub") ? "on" : "OFF"),
              "frames: " + (window.__jdFrames || 0),
              "msgs: " + messages.length,
              "op0: " + (messages[0] ? parseFloat(getComputedStyle(messages[0]).opacity).toFixed(2) : "?"),
              "support: " + (typeof CSS !== "undefined" && CSS.supports("animation-timeline: view()") ? "view()" : "none"),
            ].join("\n"));
        window.addEventListener("error", (e) => {
          badge.textContent += "\nERR: " + (e.message || "?").slice(0, 80);
        });
        mk();
        setInterval(mk, 400);
        document.body.appendChild(badge);
      }

      if (!prefersReducedMotion && messages.length > 0) {
        document.documentElement.classList.add("js-scrub");

        // Position-driven state machine. Each frame we compute, from the
        // message's LIVE position, whether it should be revealed:
        //   fly IN  once its top rises past a line ~160px above the viewport
        //           bottom (with a little hysteresis so it can't thrash),
        //   fly OUT once it falls back below ~100px above the bottom, or
        //           fully leaves the top.
        // The actual motion is a CSS transition (see global.css) that pops
        // the bubble up in ~0.45s regardless of scroll speed — "scroll slowly,
        // text flies up quickly." State is a pure function of position, so
        // every pass is identical and scrolling up cleanly reverses it.
        const apply = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          for (const el of messages) {
            const row = el.parentElement
              ? el.parentElement.getBoundingClientRect()
              : el.getBoundingClientRect();
            const inBand = row.top < vh - 160 && row.bottom > 40;
            const outBand = row.top > vh - 100 || row.bottom < 0;
            if (!el.__shown && inBand) {
              el.__shown = true;
              el.classList.add("revealed");
            } else if (el.__shown && outBand) {
              el.__shown = false;
              el.classList.remove("revealed");
            }
          }
          window.__jdFrames = (window.__jdFrames || 0) + 1;
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }
    </script>
  </body>
</html>