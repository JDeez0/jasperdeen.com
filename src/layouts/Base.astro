---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // One mechanism for the fly-up reveal: a tiny per-frame scroll-scrub
      // that drives each message's opacity/transform from its LIVE viewport
      // position (cover-range math: 0% fully below the fold → 100% fully
      // exited past the top, with a fast springy pop-in on the first 10% and
      // a mirrored fly-out on the last 10%). Scrolling up reverses it, every
      // pass is identical, and it works in every engine. We deliberately do
      // NOT rely on CSS animation-timeline: Firefox 154 advertises support
      // but mis-renders the range keyframes (messages stay static).
      //
      // When JS is off or prefers-reduced-motion is set, nothing runs and
      // all text is simply visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const messages = Array.from(document.querySelectorAll(".message"));

      // ---- DEV-ONLY diagnostic badge (never ships in production) ----
      if (import.meta.env.DEV) {
        const badge = document.createElement("div");
        badge.id = "jd-diag";
        badge.style.cssText =
          "position:fixed;left:8px;bottom:8px;z-index:9999;font:11px/1.5 monospace;" +
          "background:rgba(0,0,0,.8);color:#0f0;padding:4px 8px;border-radius:4px;" +
          "pointer-events:none;white-space:pre";
        const mk = () =>
          (badge.textContent =
            [
              "RM(no-pref/off): " + (prefersReducedMotion ? "REDUCE-ON" : "off"),
              "scrub: " + (document.documentElement.classList.contains("js-scrub") ? "on" : "OFF"),
              "frames: " + (window.__jdFrames || 0),
              "msgs: " + messages.length,
              "op0: " + (messages[0] ? parseFloat(getComputedStyle(messages[0]).opacity).toFixed(2) : "?"),
              "support: " + (typeof CSS !== "undefined" && CSS.supports("animation-timeline: view()") ? "view()" : "none"),
            ].join("\n"));
        window.addEventListener("error", (e) => {
          badge.textContent += "\nERR: " + (e.message || "?").slice(0, 80);
        });
        mk();
        setInterval(mk, 400);
        document.body.appendChild(badge);
      }

      if (!prefersReducedMotion && messages.length > 0) {
        document.documentElement.classList.add("js-scrub");

        // Set initial hidden state synchronously (before first paint) so
        // below-fold messages start at opacity 0 and reveal as you scroll.
        for (const el of messages) {
          el.style.opacity = "0";
          el.style.transform = "translateY(26px) scale(0.95)";
        }

        const apply = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          for (const el of messages) {
            // Read the PARENT's rect (untransformed, stable): the message's
            // own rect is shifted by its translateY/scale animation.
            const row = el.parentElement
              ? el.parentElement.getBoundingClientRect()
              : el.getBoundingClientRect();
            // Optimization: skip only messages FAR off-screen (beyond their
            // own height past either edge) — they can't be visible. Messages
            // near the viewport always compute, so scrolling up always lets
            // a message finish its fly-OUT (opacity → 0).
            if (row.bottom < -row.height || row.top > vh + row.height) continue;
            // Progress: 0 while fully below the viewport, 1 once fully
            // exited past the top (cover-range math).
            const raw = Math.max(0, Math.min(1, (vh - row.top) / (vh + row.height)));
            let p;
            if (raw <= 0.1) {
              p = raw / 0.1; // fly-in ramp 0..1 (mirrors keyframes 0-10%)
            } else if (raw >= 0.9) {
              p = (1 - raw) / 0.1; // fly-out mirror 1..0 (keyframes 90-100%)
            } else {
              p = 1; // fully visible plateau (keyframes 10-90%)
            }
            // Spring overshoot — cubic-bezier(0.34,1.56,0.64,1) easeOutBack,
            // applied to opacity and transform so the fade + fly match.
            const c1 = 1.70158;
            const c3 = c1 + 1;
            const t = 1 + c3 * Math.pow(p - 1, 3) + c1 * Math.pow(p - 1, 2);
            el.style.opacity = String(Math.min(1, t));
            el.style.transform = `translateY(${(1 - t) * 26}px) scale(${1 - (1 - t) * 0.05})`;
          }
          window.__jdFrames = (window.__jdFrames || 0) + 1;
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        requestAnimationFrame(onRaf);
      }
    </script>
  </body>
</html>