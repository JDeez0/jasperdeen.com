---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // Pinned conversation, revealed purely by scroll progress — no timers.
      // The chat section (.chat) is a tall RUNWAY. Its contents (.pin) are
      // sticky to the viewport top, so once "Building a space…" arrives at
      // the top it STAYS there and the page keeps accepting scroll while the
      // conversation doesn't move. New messages reveal from how far the
      // runway has been consumed, stacking below the pinned first bubble.
      // Each message demands REVEAL_STEP px of extra scroll (super-staggered),
      // and reversing scroll unwinds them last-in-first-out. When you stop
      // scrolling, nothing changes. With JS off or prefers-reduced-motion,
      // this is a normal page with all text visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const messages = Array.from(document.querySelectorAll(".message"));
      const chat = document.querySelector(".chat");

      if (!prefersReducedMotion && messages.length > 0 && chat) {
        document.documentElement.classList.add("js-scrub");

        // Distance model (all in px of absolute page scroll):
        //   The reveals start when the QUESTION reaches the TOP THIRD of the
        //   viewport (questionDoc − vh/3), not when it pins at the very top.
        //   The FIRST bubble flies in LEAD px after that; every message after
        //   waits STEP more than the one before it. No timers: distance IS
        //   scroll amount.
        //   Threshold for message i:  anchor + LEAD + i × STEP
        const LEAD = 60;   // a little extra before the first bubble
        const STEP = 200;  // scroll distance between messages after the first
        const HYST = 60;   // unwind happens HYST px before the entry point
        const TRAIL = 260; // runway left after the last reveal
        const n = messages.length;
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const arrow = document.querySelector(".scroll-indicator");

        // Absolute scroll position where the question sits at the TOP TWO-
        // FIFTHS (vh × 0.4) of the viewport — slightly earlier than the
        // previous top-third. That's when the conversation begins revealing.
        //
        // Must be measured AFTER layout is settled. On a COLD first load the
        // script can run before web fonts / async CSS are applied, so a
        // one-time read of question.getBoundingClientRect() yields a wrong
        // (too-large) anchor and reveals fire late (only when the question
        // reaches the very top). Refresh fixes it because fonts/CSS are
        // cached. We therefore re-measure once fonts are ready and again on
        // window load, guarded so we only trust measurements taken near the
        // top of the page (after the sticky pin engages, the question's
        // document offset stops being scroll-invariant).
        const question = document.querySelector(".question");
        const measureAnchor = () => {
          if (!question) return vh * 0.6;
          return question.getBoundingClientRect().top + (window.scrollY || 0) - vh * 0.4;
        };
        const refreshAnchor = () => {
          const early = (window.scrollY || 0) < 300; // don't re-measure mid-scroll
          requestAnimationFrame(() => {
            if (!early) return;
            const a = measureAnchor();
            if (Math.abs(a - anchor) > 2) {
              anchor = a;
              chat.style.height = anchor + LEAD + n * STEP + TRAIL + "px";
            }
          });
        };
        let anchor = measureAnchor();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(refreshAnchor).catch(() => {});
        }
        window.addEventListener("load", refreshAnchor);

        // Build the runway so the last message's threshold is reachable.
        chat.style.height = anchor + LEAD + n * STEP + TRAIL + "px";

        const apply = () => {
          const scrollY = window.pageYOffset || window.scrollY || 0;
          // The fixed arrow fades out as the user nears the end of the page.
          if (arrow) {
            const nearBottom =
              scrollY >= ((document.documentElement || document.body).scrollHeight - vh - 120);
            arrow.classList.toggle("is-hidden", nearBottom);
          }
          for (let i = 0; i < n; i++) {
            const el = messages[i];
            const inAt = anchor + LEAD + i * STEP;
            const outAt = inAt - HYST;
            if (!el.__shown && scrollY >= inAt) {
              el.__shown = true;
              el.classList.add("revealed");
            } else if (el.__shown && scrollY < outAt) {
              el.__shown = false;
              el.classList.remove("revealed");
            }
          }
        };

        const onRaf = () => {
          apply();
          requestAnimationFrame(onRaf);
        };
        apply();
        requestAnimationFrame(onRaf);
      }
    </script>
  </body>
</html>