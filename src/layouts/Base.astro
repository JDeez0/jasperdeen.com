---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="sheet">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jasper Deen - home" title="Home">JD</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Jasper H. Deen</p>
      </footer>
    </div>

    <script>
      // Seamless scroll-scrub fallback for browsers WITHOUT CSS scroll-driven
      // animations (animation-timeline: view()). Mimics the CSS path exactly:
      // each message's progress is driven 1:1 by its own position in the
      // viewport, so scrolling up reverses it and every pass looks identical —
      // no timed "fly-in" that can lag, skip, or fire twice.
      //
      // Progress mapping (matches the CSS 0/10/90/100 keyframes):
      //   - while the message travels its [entry → exit] band, read
      //     `entryDistance / screen` as raw progress
      //   - convert: [0  → 0.10]   => fly in  (opacity 0→1, translateY 26px→0,
      //                                        scale .95→1, spring overshoot)
      //   -          [0.10→0.90]   => fully visible
      //   -          [0.90→1.00]   => fly out (mirror of fly-in)
      //
      // Reads only transform + opacity (GPU-composited), on rAF; respects
      // prefers-reduced-motion (no class → static text). If IntersectionObserver
      // is missing, messages simply stay visible.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const supportsViewTimeline =
        typeof CSS !== "undefined" &&
        typeof CSS.supports === "function" &&
        CSS.supports("animation-timeline: view()");

      const messages = Array.from(document.querySelectorAll(".message"));
      if (
        !prefersReducedMotion &&
        !supportsViewTimeline &&
        messages.length > 0
      ) {
        document.documentElement.classList.add("js-scrub");

        if ("IntersectionObserver" in window && typeof requestAnimationFrame === "function") {
          const els = messages.map((el) => ({ el, rect: null }));
          const rectCache = () => {
            const vh = window.innerHeight || document.documentElement.clientHeight;
            for (const m of els) {
              const r = m.el.getBoundingClientRect();
              m.rect = {
                top: Math.max(0, Math.min(vh, r.top)),
                h: r.height,
              };
            }
            return vh;
          };

          let lastVh = window.innerHeight || 800;
          window.addEventListener("resize", () => {
            lastVh = rectCache();
          });

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  const m = els.find((m) => m.el === entry.target);
                  if (m) m.on = true;
                } else {
                  const m = els.find((m) => m.el === entry.target);
                  if (m) m.on = false;
                }
              }
            },
            { rootMargin: "18% 0px 18% 0px" },
          );
          messages.forEach((el) => observer.observe(el));

          const apply = (vh) => {
            for (const m of els) {
              if (!m.on || !m.rect) continue;
              const top = m.rect.top;
              const h = m.rect.h;
              const entryDistance = vh - top;
              const band = vh + h;
              const raw = Math.max(0, Math.min(1, entryDistance / band));
              let p;
              if (raw <= 0.1) {
                p = raw / 0.1; // fly-in ramp 0..1
              } else if (raw >= 0.9) {
                p = (1 - raw) / 0.1; // fly-out mirror 1..0
              } else {
                p = 1; // fully visible plateau
              }
              // Spring overshoot on the in/out ramps (cubic-bezier style easeOutBack)
              const t = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
              const opacity = p;
              const translateY = (1 - t) * 26;
              const scale = 1 - (1 - t) * 0.05;
              m.el.style.opacity = String(opacity);
              m.el.style.transform = `translateY(${translateY}px) scale(${scale})`;
            }
          };

          const onRaf = () => {
            apply(lastVh);
            requestAnimationFrame(onRaf);
          };

          lastVh = rectCache();
          // Start looking at the fold immediately (don't wait for first IO tick)
          const foldProbe = () => {
            const vh = window.innerHeight || 800;
            for (const m of els) {
              const top = m.rect ? m.rect.top : 0;
              m.on = top >= -vh * 0.18 && top <= vh * 1.18;
            }
          };
          foldProbe();
          apply(lastVh);
          requestAnimationFrame(onRaf);
        } else {
          // No IO / no rAF: leave messages static (all visible).
        }
      }
    </script>
  </body>
</html>